{
  "name": "axyron-dental-master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "studio": "vite --config vite.studio.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.prerender.config.ts && node scripts/prerender.mjs",
    "build:studio": "tsc --noEmit && vite build --config vite.studio.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-isolation=none --test-reporter=spec tests/*.test.ts",
    "test:e2e": "playwright test",
    "clinic:apply": "node scripts/use-clinic.mjs",
    "preview:studio": "vite preview --config vite.studio.config.ts",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "lighthouse": "^12.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=22.16"
  }
}
